# Build outputs -- everything here is regenerated by MPLAB/CMake/Ninja/xc32,
# keep only source files, project/make files (cmake/*.cmake, CMakeLists.txt,
# CMakePresets.json, user.cmake), and .vscode configuration.

# CMake/Ninja build tree
_build/

# Final build artifacts (.elf/.hex copied out of _build)
out/

# MPLAB-regenerated CMake fragments (rule.cmake, file.cmake, toolchain.cmake, etc.)
# -- CMakeLists.txt, CMakePresets.json, and user.cmake alongside this are
#    hand-maintained project files and stay tracked
cmake/**/.generated/

# Build artifacts, in case any end up outside _build/ or out/
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.a
compile_commands.json
